---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedPosts } from '../utils/posts';

const allPosts = await getPublishedPosts();
const recentPosts = allPosts.slice(0, 3);

// Curated featured projects for the homepage
const featuredProjects = [
  {
    title: 'PulseDB',
    description: 'An embedded, append-only time-series storage engine written in Rust for resource-constrained IoT sensors.',
    tech: ['Rust', 'Storage Engine', 'LSM-Tree'],
    githubUrl: 'https://github.com',
    liveUrl: 'https://github.com',
    featured: true,
  },
  {
    title: 'KubeWatch Lite',
    description: 'A minimal CLI daemon that monitors Kubernetes pod lifecycle events and streams structured alerts to Discord and Slack webhooks.',
    tech: ['Go', 'Kubernetes API', 'CLI'],
    githubUrl: 'https://github.com',
    featured: true,
  },
];
---

<BaseLayout>
  <div class="space-y-16 sm:space-y-20">
    <!-- Hero / Personal Introduction -->
    <section class="space-y-6 pt-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono border border-emerald-500/20 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Available for technical advisory & open source</span>
      </div>

      <div class="space-y-4">
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 leading-tight">
          Hi, I'm Mando. <br />
          <span class="text-zinc-500 dark:text-zinc-400 font-normal">
            Software engineer, systems enthusiast, and builder.
          </span>
        </h1>
        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed max-w-2xl font-serif">
          Welcome to my personal corner of the internet. This website is a repository of technical writing, software experiments, systems architecture notes, and lessons learned from shipping code to production.
        </p>
      </div>

      <!-- Quick Links / Status -->
      <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-zinc-500 dark:text-zinc-400 pt-2">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Remote / Earth</span>
        </div>
        <span>&middot;</span>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <span>Go, Rust, TypeScript, Linux</span>
        </div>
        <span>&middot;</span>
        <a href="/about" class="underline hover:text-zinc-900 dark:hover:text-zinc-200">
          More about me &rarr;
        </a>
      </div>
    </section>

    <!-- Recent Articles Section -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-zinc-200/80 dark:border-zinc-800/80 pb-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Recent Writing
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
            Thoughts on distributed systems, Linux, and developer tools.
          </p>
        </div>
        <a
          href="/blog"
          class="text-xs font-mono text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 transition-colors inline-flex items-center gap-1"
        >
          <span>All articles</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="space-y-4">
        {recentPosts.length > 0 ? (
          recentPosts.map((post) => (
            <PostCard post={post} />
          ))
        ) : (
          <p class="text-sm text-zinc-500">No articles published yet.</p>
        )}
      </div>
    </section>

    <!-- Selected Projects Section -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-zinc-200/80 dark:border-zinc-800/80 pb-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Selected Projects
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
            Open-source utilities and system tools I have engineered.
          </p>
        </div>
        <a
          href="/projects"
          class="text-xs font-mono text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 transition-colors inline-flex items-center gap-1"
        >
          <span>All projects</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {featuredProjects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
