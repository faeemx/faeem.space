---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedPosts } from '../utils/posts';

const allPosts = await getPublishedPosts();
const recentPosts = allPosts.slice(0, 3);

// Curated personal projects
const featuredProjects = [
  {
    title: 'Ponder',
    description: 'A quiet morning journal that prompts you with a single, thoughtful question each day. Offline-first, local Markdown storage, zero metrics.',
    tech: ['Local-First', 'Markdown', 'Writing'],
    githubUrl: 'https://github.com',
    liveUrl: 'https://github.com',
    featured: true,
  },
  {
    title: 'Teatime',
    description: 'A tiny, distraction-free desktop steep timer for whole-leaf tea lovers. Gentle chime audio, no accounts, no subscriptions.',
    tech: ['Web Audio', 'Minimalist', 'Craft'],
    githubUrl: 'https://github.com',
    featured: true,
  },
];
---

<BaseLayout>
  <div class="space-y-16 sm:space-y-20">
    <!-- Hero / Personal Introduction -->
    <section class="space-y-6 pt-4">
      <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-6 sm:gap-8">
        <div class="space-y-4 flex-1">
          <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#231f1c] dark:text-[#f3ede4] leading-tight">
            Hi, I'm Faeem. <br />
            <span class="text-[#756c63] dark:text-[#968d81] font-normal">
              Writer, creator, and curious observer.
            </span>
          </h1>
          <p class="text-base sm:text-lg text-[#4d443b] dark:text-[#ccc4b6] leading-relaxed max-w-xl font-serif">
            Welcome to my quiet corner of the internet. This site is a personal notebook where I share longform essays on craft, small self-made tools, books I'm reading, and reflections on living intentionally in an over-connected world.
          </p>
        </div>

        <!-- Space / Gravity Cosmos Emblem -->
        <div class="shrink-0 self-start sm:self-center">
          <div class="w-20 h-20 sm:w-28 sm:h-28 rounded-2xl bg-[#f2ece0]/80 dark:bg-[#201d19] border border-[#e8e0d2] dark:border-[#2f2a24] p-3 flex items-center justify-center text-[#9e471d] dark:text-[#e57e4b] shadow-xs">
            <svg
              class="w-full h-full fill-current opacity-90 hover:opacity-100 hover:rotate-12 transition-all duration-300"
              viewBox="0 0 256 256"
              aria-label="Cosmos gravity emblem"
              role="img"
            >
              <path d="M127.1,94.4c19.9,0,36.1,15.8,36.1,35.3s-16.2,35.3-36.1,35.3s-36.1-15.8-36.1-35.3S107.2,94.4,127.1,94.4z M127.1,65.7  c-36,0-65.2,28.7-65.2,63.9s29.2,63.9,65.2,63.9c15.7,0,30.2-5.5,41.5-14.7c1.9,1.3,4.2,1.9,6.8,1.9c7,0,12.6-5.5,12.6-12.2  c0-3.3-1.3-6.2-3.5-8.4c5.1-9.1,7.9-19.5,7.9-30.5C192.3,94.3,163.1,65.7,127.1,65.7z M181.2,157.6c-1.7-0.8-3.7-1.4-5.8-1.4  c-7,0-12.6,5.5-12.6,12.2c0,2.8,1.1,5.6,2.7,7.6c-10.4,8.3-23.8,13.3-38.4,13.3c-33.7,0-61.1-26.9-61.1-59.9s27.4-59.9,61.1-59.9  s61.1,26.9,61.1,59.9C188.3,139.6,185.7,149.2,181.2,157.6z M251,67.5c0-11.7-9.7-21.2-21.6-21.2c-4.9,0-9.3,1.6-13,4.2  c-22.2-22.9-53.9-37.2-89-37.2c-67,0-121.5,52.1-121.5,116.2s54.5,116.2,121.5,116.2s121.5-52.1,121.5-116.2  c0-15.4-3.2-30.1-8.9-43.5C246.6,82.2,251,75.4,251,67.5z M244.8,129.4c0,61.9-52.6,112.3-117.4,112.3S9.9,191.2,9.9,129.4  S62.6,17.1,127.3,17.1c34,0,64.6,13.8,86.1,36c-3.5,3.8-5.7,8.8-5.7,14.3c0,11.7,9.7,21.2,21.6,21.2c2.4,0,4.7-0.4,7-1.2  C241.8,100.5,244.8,114.6,244.8,129.4z M127.7,49.5c-11.4,0-22.3,2.3-32.1,6.4c-1.6-2.4-4.4-4-7.6-4c-5.1,0-9.1,4-9.1,9  c0,1.4,0.3,2.7,0.9,3.9c-20.6,14.6-34,38.2-34,64.9c0,44.2,36.7,80.2,81.8,80.2s81.8-36,81.8-80.2S172.7,49.5,127.7,49.5z   M127.7,205.9c-42.8,0-77.7-34.2-77.7-76.2c0-25.4,12.8-47.9,32.3-61.8c1.6,1.3,3.5,1.9,5.7,1.9c5.1,0,9.1-4,9.1-9  c0-0.4,0-0.8-0.1-1.2c9.4-4,19.8-6.2,30.7-6.2c42.8,0,77.7,34.2,77.7,76.2S170.5,205.9,127.7,205.9z"/>
            </svg>
          </div>
        </div>
      </div>

      <!-- Quick Links / Details -->
      <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-[#756c63] dark:text-[#968d81] pt-2">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#8c8275]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span>Reading, walking, brewing tea</span>
        </div>
        <span>&middot;</span>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#8c8275]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
          </svg>
          <span>Essays, notes & small tools</span>
        </div>
        <span>&middot;</span>
        <a href="/about" class="underline hover:text-[#231f1c] dark:hover:text-[#f3ede4]">
          More about me &rarr;
        </a>
      </div>
    </section>

    <!-- Recent Essays Section -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-[#e8e0d2] dark:border-[#2f2a24] pb-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#231f1c] dark:text-[#f3ede4]">
            Recent Essays
          </h2>
          <p class="text-xs sm:text-sm text-[#756c63] dark:text-[#968d81] mt-1">
            Reflections on creative work, quiet computing, and everyday life.
          </p>
        </div>
        <a
          href="/blog"
          class="text-xs font-mono text-[#756c63] dark:text-[#968d81] hover:text-[#231f1c] dark:hover:text-[#f3ede4] transition-colors inline-flex items-center gap-1"
        >
          <span>All essays</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="space-y-4">
        {recentPosts.length > 0 ? (
          recentPosts.map((post) => (
            <PostCard post={post} />
          ))
        ) : (
          <p class="text-sm text-[#756c63]">No essays published yet.</p>
        )}
      </div>
    </section>

    <!-- Selected Creations Section -->
    <section class="space-y-6">
      <div class="flex items-baseline justify-between border-b border-[#e8e0d2] dark:border-[#2f2a24] pb-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#231f1c] dark:text-[#f3ede4]">
            Small Creations
          </h2>
          <p class="text-xs sm:text-sm text-[#756c63] dark:text-[#968d81] mt-1">
            Personal tools and gentle software experiments built for daily use.
          </p>
        </div>
        <a
          href="/projects"
          class="text-xs font-mono text-[#756c63] dark:text-[#968d81] hover:text-[#231f1c] dark:hover:text-[#f3ede4] transition-colors inline-flex items-center gap-1"
        >
          <span>All projects</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {featuredProjects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
