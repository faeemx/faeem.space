---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    category: 'Small Software & Tools',
    items: [
      {
        title: 'Ponder',
        description: 'A quiet morning reflection journal that prompts you with a single thoughtful question each day. Stores entries as local Markdown files without accounts or telemetry.',
        tech: ['Local-First', 'Writing', 'Markdown', 'Calm'],
        githubUrl: 'https://github.com',
        liveUrl: 'https://github.com',
        featured: true,
      },
      {
        title: 'Teatime',
        description: 'A minimal, distraction-free desktop steep timer with gentle chime audio designed for brewing loose-leaf tea with intention.',
        tech: ['Audio', 'Tea Brewing', 'Minimalist'],
        githubUrl: 'https://github.com',
        liveUrl: 'https://github.com',
        featured: true,
      },
      {
        title: 'Commonplace',
        description: 'A personal digital slip-box for capturing memorable book quotes, essay passages, and fleeting thoughts discovered during reading.',
        tech: ['Reading', 'Personal Wiki', 'Notes'],
        githubUrl: 'https://github.com',
      },
    ],
  },
  {
    category: 'Creative Experiments & Publishing',
    items: [
      {
        title: 'faeem.space',
        description: 'This website—a fast, typography-centered personal publishing space built without ads, tracking, or unnecessary scripts.',
        tech: ['Astro', 'Editorial', 'SSG', 'Reading'],
        githubUrl: 'https://github.com',
        liveUrl: 'https://faeem.space',
        featured: true,
      },
      {
        title: 'Folio (Film Journal)',
        description: 'An offline-first photo gallery generator built to catalog 35mm film scans, camera settings, and handwritten field notes.',
        tech: ['Photography', 'Film Scans', 'Gallery'],
        githubUrl: 'https://github.com',
      },
      {
        title: 'Letterbox',
        description: 'A little CLI utility that turns email newsletters into a calm, static RSS feed so I can read longform writing on my own terms.',
        tech: ['RSS', 'Email Archive', 'Quiet Web'],
        githubUrl: 'https://github.com',
      },
    ],
  },
];
---

<BaseLayout
  title="Projects"
  description="Personal software, quiet tools, and creative experiments built by Faeem."
>
  <div class="space-y-12">
    <!-- Header -->
    <header class="space-y-3 pb-8 border-b border-[#e8e0d2] dark:border-[#2f2a24]">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#231f1c] dark:text-[#f3ede4]">
        Projects & Tools
      </h1>
      <p class="text-base sm:text-lg text-[#5a5249] dark:text-[#b8b0a4] max-w-2xl font-serif leading-relaxed">
        A collection of small tools, quiet applications, and digital experiments built for an audience of one and shared freely with anyone who might find them useful.
      </p>
    </header>

    <!-- Project Sections by Category -->
    <div class="space-y-12">
      {projects.map((section) => (
        <section class="space-y-5">
          <div class="flex items-center gap-3">
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#231f1c] dark:text-[#f3ede4]">
              {section.category}
            </h2>
            <div class="h-px flex-1 bg-[#e8e0d2] dark:bg-[#2f2a24]"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {section.items.map((item) => (
              <ProjectCard {...item} />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
