---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getAllCategories, type BlogPost } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = await getAllCategories();

  return categories.map((cat) => {
    const matchingPosts = posts.filter(
      (p) => p.data.category?.trim().toLowerCase() === cat.name.toLowerCase()
    );

    return {
      params: { category: cat.slug },
      props: {
        categoryName: cat.name,
        posts: matchingPosts,
        allCategories: categories,
      },
    };
  });
}

interface Props {
  categoryName: string;
  posts: BlogPost[];
  allCategories: Array<{ name: string; count: number; slug: string }>;
}

const { categoryName, posts, allCategories } = Astro.props;
---

<BaseLayout
  title={`Category: ${categoryName}`}
  description={`Browse all essays filed under ${categoryName} by Mando.`}
>
  <div class="space-y-10">
    <!-- Back to blog -->
    <div>
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200 transition-colors"
      >
        <span>&larr;</span>
        <span>All essays</span>
      </a>
    </div>

    <!-- Page Header -->
    <header class="space-y-3">
      <div class="flex items-center gap-3">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-stone-950 dark:text-stone-50">
          {categoryName}
        </h1>
        <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-stone-200/80 dark:bg-stone-800 text-stone-700 dark:text-stone-300">
          {posts.length} {posts.length === 1 ? 'essay' : 'essays'}
        </span>
      </div>
      <p class="text-stone-600 dark:text-stone-400 font-serif text-sm sm:text-base">
        Showing all writings filed under the <strong class="text-stone-900 dark:text-stone-100">{categoryName}</strong> category.
      </p>
    </header>

    <!-- Categories pill bar -->
    <div class="pt-2 pb-4 border-y border-stone-200/80 dark:border-stone-800/80">
      <div class="text-xs font-mono text-stone-500 dark:text-stone-400 uppercase tracking-wider mb-2.5">
        Categories
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href="/blog"
          class="px-3 py-1 rounded-md text-xs font-mono border border-stone-200/80 dark:border-stone-800 bg-stone-100/70 dark:bg-stone-900/40 text-stone-600 dark:text-stone-400 hover:text-stone-900 transition-colors"
        >
          All
        </a>
        {allCategories.map((c) => (
          <a
            href={`/category/${c.slug}`}
            class:list={[
              "px-3 py-1 rounded-md text-xs font-mono border transition-colors",
              c.name === categoryName
                ? "bg-stone-300 text-stone-950 border-stone-400 dark:bg-stone-800 dark:text-stone-100 dark:border-stone-700 font-medium"
                : "bg-stone-100/70 text-stone-600 border-stone-200/80 hover:text-stone-950 dark:bg-stone-900/40 dark:text-stone-400 dark:border-stone-800 dark:hover:text-stone-200"
            ]}
          >
            <span>{c.name}</span>
            <span class="text-[11px] opacity-60 ml-1">({c.count})</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Posts Feed -->
    <div class="space-y-4">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
