---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getAllCategories, type BlogPost } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = await getAllCategories();

  return categories.map((cat) => {
    const matchingPosts = posts.filter(
      (p) => p.data.category?.trim().toLowerCase() === cat.name.toLowerCase()
    );

    return {
      params: { category: cat.slug },
      props: {
        categoryName: cat.name,
        posts: matchingPosts,
        allCategories: categories,
      },
    };
  });
}

interface Props {
  categoryName: string;
  posts: BlogPost[];
  allCategories: Array<{ name: string; count: number; slug: string }>;
}

const { categoryName, posts, allCategories } = Astro.props;
---

<BaseLayout
  title={`Category: ${categoryName}`}
  description={`Browse all essays filed under ${categoryName} by Faeem.`}
>
  <div class="space-y-10">
    <!-- Back to blog -->
    <div>
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200 transition-colors"
      >
        <span>&larr;</span>
        <span>All essays</span>
      </a>
    </div>

    <!-- Page Header -->
    <header class="space-y-3">
      <div class="flex items-center gap-3">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#231f1c] dark:text-[#f3ede4]">
          {categoryName}
        </h1>
        <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-[#f0e8dc] dark:bg-[#26221d] text-[#554d45] dark:text-[#c4bcaf]">
          {posts.length} {posts.length === 1 ? 'essay' : 'essays'}
        </span>
      </div>
      <p class="text-[#5a5249] dark:text-[#b8b0a4] font-serif text-sm sm:text-base">
        Showing all writings filed under the <strong class="text-[#231f1c] dark:text-[#f3ede4]">{categoryName}</strong> category.
      </p>
    </header>

    <!-- Categories pill bar -->
    <div class="pt-2 pb-4 border-y border-[#e8e0d2] dark:border-[#2f2a24]">
      <div class="text-xs font-mono text-[#756c63] dark:text-[#968d81] uppercase tracking-wider mb-2.5">
        Categories
      </div>
      <div class="flex flex-wrap gap-2">
        <a
          href="/blog"
          class="px-3 py-1 rounded-md text-xs font-mono border border-[#e8dfce] dark:border-[#332e28] bg-[#f4efe5]/80 dark:bg-[#201d19] text-[#5c5348] dark:text-[#a89f92] hover:text-[#231f1c] transition-colors"
        >
          All
        </a>
        {allCategories.map((c) => (
          <a
            href={`/category/${c.slug}`}
            class:list={[
              "px-3 py-1 rounded-md text-xs font-mono border transition-colors",
              c.name === categoryName
                ? "bg-[#ebd6be] text-[#231f1c] border-[#d8be9f] dark:bg-[#3d2e22] dark:text-[#f3ede4] dark:border-[#5a4432] font-medium"
                : "bg-[#f4efe5]/80 text-[#5c5348] border-[#e8dfce] hover:text-[#231f1c] hover:border-[#cfc2ae] dark:bg-[#201d19] dark:text-[#a89f92] dark:border-[#332e28] dark:hover:text-[#f3ede4]"
            ]}
          >
            <span>{c.name}</span>
            <span class="text-[11px] opacity-60 ml-1">({c.count})</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Posts Feed -->
    <div class="space-y-4">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
