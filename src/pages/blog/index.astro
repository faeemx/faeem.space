---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getPublishedPosts, getAllTags, getAllCategories } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = await getAllTags();
const categories = await getAllCategories();
---

<BaseLayout
  title="Essays"
  description="Personal essays, reflections on slow living, books, and creative work by Faeem."
>
  <div class="space-y-10">
    <!-- Page Header -->
    <header class="space-y-3">
      <div class="flex items-center gap-2">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#231f1c] dark:text-[#f3ede4]">
          Essays & Writings
        </h1>
        <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-[#f0e8dc] dark:bg-[#26221d] text-[#554d45] dark:text-[#c4bcaf]">
          {posts.length} {posts.length === 1 ? 'essay' : 'essays'}
        </span>
      </div>
      <p class="text-[#5a5249] dark:text-[#b8b0a4] max-w-xl font-serif text-base sm:text-lg leading-relaxed">
        Thoughts on craft, quiet computing, intentional living, book notes, and personal observations.
      </p>
    </header>

    <!-- Categories & Topics filter sections -->
    <div class="space-y-4 pt-2 pb-5 border-y border-[#e8e0d2] dark:border-[#2f2a24]">
      <!-- Categories -->
      {categories.length > 0 && (
        <div>
          <div class="text-xs font-mono text-[#756c63] dark:text-[#968d81] uppercase tracking-wider mb-2">
            Categories
          </div>
          <div class="flex flex-wrap gap-2">
            <a
              href="/blog"
              class="px-2.5 py-1 rounded-md text-xs font-mono bg-[#ebd6be] text-[#231f1c] border border-[#d8be9f] dark:bg-[#3d2e22] dark:text-[#f3ede4] dark:border-[#5a4432] font-medium"
            >
              All
            </a>
            {categories.map((c) => (
              <a
                href={`/category/${c.slug}`}
                class="px-2.5 py-1 rounded-md text-xs font-mono border border-[#e8dfce] dark:border-[#332e28] bg-[#f4efe5]/80 dark:bg-[#201d19] text-[#5c5348] dark:text-[#a89f92] hover:text-[#231f1c] dark:hover:text-[#f3ede4] hover:border-[#cfc2ae] dark:hover:border-[#494239] transition-colors"
              >
                <span>{c.name}</span>
                <span class="text-[11px] opacity-60 ml-1">({c.count})</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Tags / Topics -->
      {tags.length > 0 && (
        <div class="pt-2">
          <div class="text-xs font-mono text-[#756c63] dark:text-[#968d81] uppercase tracking-wider mb-2">
            Topics
          </div>
          <div class="flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <TagBadge tag={tag.name} count={tag.count} />
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Posts Feed -->
    <div class="space-y-4">
      {posts.length > 0 ? (
        posts.map((post) => (
          <PostCard post={post} />
        ))
      ) : (
        <div class="p-8 text-center rounded-xl border border-dashed border-[#e8e0d2] dark:border-[#2f2a24] text-[#756c63]">
          No essays published yet. Check back soon!
        </div>
      )}
    </div>
  </div>
</BaseLayout>
