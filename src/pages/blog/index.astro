---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getPublishedPosts, getAllTags, getAllCategories } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = await getAllTags();
const categories = await getAllCategories();
---

<BaseLayout
  title="Essays"
  description="Personal essays, reflections on slow living, books, and creative work by Mando."
>
  <div class="space-y-10">
    <!-- Page Header -->
    <header class="space-y-3">
      <div class="flex items-center gap-2">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-stone-950 dark:text-stone-50">
          Essays & Writings
        </h1>
        <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-stone-200/80 dark:bg-stone-800 text-stone-700 dark:text-stone-300">
          {posts.length} {posts.length === 1 ? 'essay' : 'essays'}
        </span>
      </div>
      <p class="text-stone-600 dark:text-stone-400 max-w-xl font-serif text-base sm:text-lg">
        Thoughts on craft, quiet computing, intentional living, book notes, and personal observations.
      </p>
    </header>

    <!-- Categories & Topics filter sections -->
    <div class="space-y-4 pt-2 pb-5 border-y border-stone-200/80 dark:border-stone-800/80">
      <!-- Categories -->
      {categories.length > 0 && (
        <div>
          <div class="text-xs font-mono text-stone-500 dark:text-stone-400 uppercase tracking-wider mb-2">
            Categories
          </div>
          <div class="flex flex-wrap gap-2">
            <a
              href="/blog"
              class="px-2.5 py-1 rounded-md text-xs font-mono bg-stone-300 text-stone-950 border border-stone-400 dark:bg-stone-800 dark:text-stone-100 dark:border-stone-700 font-medium"
            >
              All
            </a>
            {categories.map((c) => (
              <a
                href={`/category/${c.slug}`}
                class="px-2.5 py-1 rounded-md text-xs font-mono border border-stone-200/80 dark:border-stone-800/80 bg-stone-100/70 dark:bg-stone-900/40 text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200 hover:border-stone-300 dark:hover:border-stone-700 transition-colors"
              >
                <span>{c.name}</span>
                <span class="text-[11px] opacity-60 ml-1">({c.count})</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Tags / Topics -->
      {tags.length > 0 && (
        <div class="pt-2">
          <div class="text-xs font-mono text-stone-500 dark:text-stone-400 uppercase tracking-wider mb-2">
            Topics
          </div>
          <div class="flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <TagBadge tag={tag.name} count={tag.count} />
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Posts Feed -->
    <div class="space-y-4">
      {posts.length > 0 ? (
        posts.map((post) => (
          <PostCard post={post} />
        ))
      ) : (
        <div class="p-8 text-center rounded-xl border border-dashed border-stone-300 dark:border-stone-800 text-stone-500">
          No essays published yet. Check back soon!
        </div>
      )}
    </div>
  </div>
</BaseLayout>
