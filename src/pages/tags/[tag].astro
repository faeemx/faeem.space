---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getPublishedPosts, getAllTags, type BlogPost } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = await getAllTags();

  return tags.map((t) => {
    const matchingPosts = posts.filter((post) =>
      post.data.tags?.map((item) => item.toLowerCase()).includes(t.name)
    );

    return {
      params: { tag: t.name },
      props: {
        tag: t.name,
        posts: matchingPosts,
        allTags: tags,
      },
    };
  });
}

interface Props {
  tag: string;
  posts: BlogPost[];
  allTags: Array<{ name: string; count: number }>;
}

const { tag, posts, allTags } = Astro.props;
---

<BaseLayout
  title={`Writings tagged #${tag}`}
  description={`Browse all essays tagged with #${tag} by Mando.`}
>
  <div class="space-y-10">
    <!-- Back to blog -->
    <div>
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200 transition-colors"
      >
        <span>&larr;</span>
        <span>All essays</span>
      </a>
    </div>

    <!-- Page Header -->
    <header class="space-y-3">
      <div class="flex items-center gap-3">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-stone-950 dark:text-stone-50 font-mono">
          #{tag}
        </h1>
        <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-stone-200/80 dark:bg-stone-800 text-stone-700 dark:text-stone-300">
          {posts.length} {posts.length === 1 ? 'essay' : 'essays'}
        </span>
      </div>
      <p class="text-stone-600 dark:text-stone-400 font-serif text-sm sm:text-base">
        Showing all writings tagged with <code class="text-xs font-mono">#{tag}</code>.
      </p>
    </header>

    <!-- All Tags cloud -->
    <div class="pt-2 pb-4 border-y border-stone-200/80 dark:border-stone-800/80">
      <div class="text-xs font-mono text-stone-500 dark:text-stone-400 uppercase tracking-wider mb-2.5">
        All Topics
      </div>
      <div class="flex flex-wrap gap-2">
        {allTags.map((t) => (
          <TagBadge tag={t.name} count={t.count} active={t.name === tag} />
        ))}
      </div>
    </div>

    <!-- Posts Feed -->
    <div class="space-y-4">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
