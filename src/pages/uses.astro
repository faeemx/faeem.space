---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    title: 'Writing & Analog Tools',
    description: 'Physical objects and tactile materials that help me slow down and think clearly before touching a keyboard.',
    items: [
      {
        name: 'Traveler\'s Notebook (Camel Leather)',
        desc: 'My constant everyday companion. Filled with lightweight blank paper refills for morning journaling, sketching, and stray ideas.',
      },
      {
        name: 'Pilot Custom 823 Fountain Pen (Medium Nib)',
        desc: 'Inked with Iroshizuku Tsukiyo (Moonlit Night) deep blue ink. It writes with an effortless, wet glide across paper.',
      },
      {
        name: 'Midori MD Notebooks',
        desc: 'Japanese bleed-resistant cream paper with minimal thread binding that lays completely flat on the desk.',
      },
      {
        name: 'Kindle Paperwhite (Warm Light Edition)',
        desc: 'Kept in airplane mode 99% of the time. Used for long essays, travel reading, and late-night book chapters without eye strain.',
      },
    ],
  },
  {
    title: 'Desk & Physical Workspace',
    description: 'The physical corner where I sit to write, code, and daydream.',
    items: [
      {
        name: 'Solid White Oak Table (160x80cm)',
        desc: 'Positioned right next to a large east-facing window. Finished with matte natural oil that warms under the palms.',
      },
      {
        name: 'Keychron Q1 Pro Mechanical Keyboard',
        desc: 'Customized with lubed tactile switches and retro beige PBT keycaps. Typing feels rhythmic and deliberate like an old typewriter.',
      },
      {
        name: 'Herman Miller Mirra 2 Chair',
        desc: 'Comfortable, breathable support for long sessions of reading, thinking, and drafting.',
      },
      {
        name: 'Wool Felt Desk Mat (Charcoal)',
        desc: 'Soft, warm texture under the forearms that dampens keyboard sound and creates a defined writing area.',
      },
    ],
  },
  {
    title: 'Tea & Coffee Rituals',
    description: 'The hot beverages that bookend my mornings and afternoons.',
    items: [
      {
        name: 'Hario V60 Ceramic Dripper & Buono Kettle',
        desc: 'The morning brew ritual. Measuring whole beans, grinding by hand with a Comandante C40, and pouring slowly in concentric circles.',
      },
      {
        name: 'Tokoname Clay Kyusu Teapot',
        desc: 'Unpainted natural clay teapot from Aichi, Japan. Used for brewing deep green Japanese sencha and nutty roasted hojicha in the afternoons.',
      },
    ],
  },
  {
    title: 'Digital Tools & Software',
    description: 'Quiet, well-crafted applications that get out of the way.',
    items: [
      {
        name: 'Obsidian',
        desc: 'Where all my personal reading notes, garden essays, and journals live as simple, future-proof Markdown files stored locally on my drive.',
      },
      {
        name: 'NetNewsWire',
        desc: 'A fast, calm open-source RSS reader for Mac and iOS. No algorithmic curation—just the independent blogs and writers I follow.',
      },
      {
        name: 'Visual Studio Code & Ghostty',
        desc: 'Stripped of heavy popups and AI distractions, configured with clean monospace typography and generous line heights.',
      },
      {
        name: 'Things 3',
        desc: 'The only task manager that feels like a clean piece of paper rather than a stressful project management dashboard.',
      },
    ],
  },
];
---

<BaseLayout
  title="Uses"
  description="Tools, books, analog pens, coffee gear, and workspace objects used by Faeem."
>
  <div class="max-w-[720px] mx-auto space-y-12">
    <!-- Header -->
    <header class="space-y-3 pb-8 border-b border-[#e8e0d2] dark:border-[#2f2a24]">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#231f1c] dark:text-[#f3ede4]">
        Things I Use
      </h1>
      <p class="text-base sm:text-lg text-[#5a5249] dark:text-[#b8b0a4] font-serif leading-relaxed">
        A curated list of the physical tools, pens, notebooks, coffee rituals, and quiet software I reach for every day.
      </p>
    </header>

    <!-- Sections -->
    <div class="space-y-12">
      {sections.map((section) => (
        <section class="space-y-5">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#231f1c] dark:text-[#f3ede4]">
              {section.title}
            </h2>
            <p class="text-xs sm:text-sm text-[#756c63] dark:text-[#968d81] mt-1">
              {section.description}
            </p>
          </div>

          <div class="divide-y divide-[#e8e0d2] dark:divide-[#2f2a24] rounded-xl border border-[#e8e0d2] dark:border-[#2f2a24] bg-white dark:bg-[#1f1c19] overflow-hidden">
            {section.items.map((item) => (
              <div class="p-4 sm:p-5 flex flex-col gap-1">
                <span class="text-sm font-semibold text-[#231f1c] dark:text-[#f3ede4] font-mono">
                  {item.name}
                </span>
                <span class="text-sm text-[#5a5249] dark:text-[#b8b0a4] leading-relaxed font-serif">
                  {item.desc}
                </span>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
