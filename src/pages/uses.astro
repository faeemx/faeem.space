---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    title: 'Workstation & Hardware',
    description: 'Physical machines and peripherals that keep me productive day in and day out.',
    items: [
      {
        name: 'Apple MacBook Pro 16" (M3 Max, 64GB RAM)',
        desc: 'My primary workhorse for mobile and day-to-day engineering. The battery efficiency and compile speeds are unmatched.',
      },
      {
        name: 'Dell UltraSharp 32" 4K (U3223QE)',
        desc: 'Matte IPS panel with excellent color accuracy and built-in USB-C hub with single-cable charging.',
      },
      {
        name: 'Keychron Q1 Pro (Custom Gateron Oil Kings)',
        desc: 'Solid aluminum 75% mechanical keyboard with wireless support, customized with lubed linear switches.',
      },
      {
        name: 'Logitech MX Master 3S',
        desc: 'The horizontal thumb scroll and quiet magnetic switches make code and document navigation effortless.',
      },
      {
        name: 'Sony WH-1000XM5 Headphones',
        desc: 'Essential for deep focus blocks and blocking ambient background noise in coffee shops and open spaces.',
      },
    ],
  },
  {
    title: 'Development Environment & Software',
    description: 'Tools, editors, and terminal utilities configured for minimal friction.',
    items: [
      {
        name: 'Visual Studio Code & Neovim',
        desc: 'VS Code with custom minimal keybindings for complex projects; Neovim with Lua configs for quick terminal edits and server sessions.',
      },
      {
        name: 'Ghostty & WezTerm',
        desc: 'GPU-accelerated modern terminal emulators configured with true color support and seamless font rendering.',
      },
      {
        name: 'JetBrains Mono & Inter',
        desc: 'JetBrains Mono with ligatures for code; Inter and Literata for prose and editorial reading.',
      },
      {
        name: 'Fish Shell + Starship Prompt',
        desc: 'Snappy autosuggestions, clean tab completions, and an informative yet minimal status prompt.',
      },
      {
        name: 'Git + Delta',
        desc: 'Git with git-delta for syntax-highlighted, side-by-side terminal diffs and pager navigation.',
      },
    ],
  },
  {
    title: 'Homelab & Cloud Infrastructure',
    description: 'Self-hosted computing and edge platforms I rely on for services and deployments.',
    items: [
      {
        name: 'Custom Mini-PC (Debian 12 Bookworm)',
        desc: 'Intel Core i5-12400, 32GB ECC RAM, dual 1TB NVMe mirrors + dual 8TB ZFS mirrors for storage.',
      },
      {
        name: 'Docker & Docker Compose',
        desc: 'Container management for homelab services: Caddy reverse proxy, Pi-hole, Vaultwarden, and backup agents.',
      },
      {
        name: 'Cloudflare (Workers, Pages, DNS)',
        desc: 'Authoritative DNS management, edge caching, zero-trust tunnels, and serverless hosting.',
      },
      {
        name: 'Restic & Backblaze B2',
        desc: 'Automated, deduplicated, and client-side encrypted off-site backups triggered nightly via systemd timers.',
      },
    ],
  },
];
---

<BaseLayout
  title="Uses"
  description="Hardware, developer software, editor configurations, and tools used by Mando."
>
  <div class="max-w-[720px] mx-auto space-y-12">
    <!-- Header -->
    <header class="space-y-3 pb-8 border-b border-zinc-200/80 dark:border-zinc-800/80">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Uses
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 font-serif leading-relaxed">
        A living catalog of the hardware, developer tooling, terminal environment, and homelab setup I use on a daily basis.
      </p>
    </header>

    <!-- Sections -->
    <div class="space-y-12">
      {sections.map((section) => (
        <section class="space-y-5">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
              {section.title}
            </h2>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
              {section.description}
            </p>
          </div>

          <div class="divide-y divide-zinc-200/80 dark:divide-zinc-800/80 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/40 dark:bg-zinc-900/20 overflow-hidden">
            {section.items.map((item) => (
              <div class="p-4 sm:p-5 flex flex-col gap-1">
                <span class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 font-mono">
                  {item.name}
                </span>
                <span class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-serif">
                  {item.desc}
                </span>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
