---
interface Props {
  title: string;
  description: string;
  tech: string[];
  githubUrl?: string;
  liveUrl?: string;
  featured?: boolean;
}

const { title, description, tech, githubUrl, liveUrl, featured = false } = Astro.props;
---

<div class:list={[
  "flex flex-col justify-between p-5 sm:p-6 rounded-xl border transition-all",
  featured
    ? "border-amber-500/30 dark:border-amber-500/20 bg-amber-500/5 dark:bg-stone-900/30"
    : "border-stone-200/80 dark:border-stone-800/80 bg-white/70 dark:bg-stone-900/20 hover:border-stone-300 dark:hover:border-stone-700"
]}>
  <div>
    <div class="flex items-center justify-between gap-3 mb-2">
      <h3 class="text-base sm:text-lg font-semibold tracking-tight text-stone-900 dark:text-stone-100">
        {title}
      </h3>
      {featured && (
        <span class="text-[10px] font-mono font-semibold uppercase px-2 py-0.5 rounded bg-amber-100 dark:bg-amber-900/40 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800/50">
          Featured
        </span>
      )}
    </div>

    <p class="text-sm text-stone-600 dark:text-stone-400 font-serif leading-relaxed mb-4">
      {description}
    </p>
  </div>

  <div>
    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {tech.map((t) => (
        <span class="text-xs font-mono px-2 py-0.5 rounded bg-stone-100 text-stone-600 dark:bg-stone-800 dark:text-stone-400">
          {t}
        </span>
      ))}
    </div>

    <!-- Action Links -->
    <div class="flex items-center gap-4 text-xs font-mono pt-3 border-t border-stone-100 dark:border-stone-800/50">
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-stone-600 dark:text-stone-400 hover:text-stone-950 dark:hover:text-stone-100 transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>Source</span>
        </a>
      )}
      {liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-stone-600 dark:text-stone-400 hover:text-stone-950 dark:hover:text-stone-100 transition-colors"
        >
          <span>Visit</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>
  </div>
</div>
