---
import type { BlogPost } from '../utils/posts';
import { formatDate } from '../utils/posts';
import { getReadingTime } from '../utils/readingTime';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="mt-16 pt-8 border-t border-[#e8e0d2] dark:border-[#2f2a24]">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-sm font-mono font-semibold uppercase tracking-wider text-[#756c63] dark:text-[#968d81]">
        More Writings
      </h3>
      <a
        href="/blog"
        class="text-xs font-mono text-[#756c63] dark:text-[#968d81] hover:text-[#231f1c] dark:hover:text-[#f3ede4] transition-colors"
      >
        View all &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="group p-5 rounded-xl border border-[#e8e0d2] dark:border-[#2f2a24] bg-white dark:bg-[#1f1c19] hover:border-[#cfc4b2] dark:hover:border-[#423c34] transition-all flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center gap-2 text-xs font-mono text-[#82786d] dark:text-[#91887c] mb-2">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              <span>&middot;</span>
              <span>{getReadingTime(post.body || '')}</span>
            </div>
            <h4 class="text-base font-semibold text-[#231f1c] dark:text-[#f3ede4] group-hover:text-[#9e471d] dark:group-hover:text-[#e57e4b] transition-colors line-clamp-2">
              {post.data.title}
            </h4>
          </div>
          <p class="mt-2 text-xs text-[#5a5249] dark:text-[#b8b0a4] font-serif line-clamp-2">
            {post.data.description}
          </p>
        </a>
      ))}
    </div>
  </section>
)}
