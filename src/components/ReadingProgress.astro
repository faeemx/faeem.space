---
// ReadingProgress.astro
---

<div
  id="reading-progress-bar"
  class="fixed top-0 left-0 h-[2.5px] w-full bg-emerald-500 z-50 origin-left scale-x-0 transition-transform duration-75 pointer-events-none"
  aria-hidden="true"
>
</div>

<script is:inline>
  function setupReadingProgress() {
    const bar = document.getElementById('reading-progress-bar');
    const article = document.querySelector('article');
    if (!bar || !article) return;

    let ticking = false;

    function updateProgress() {
      const rect = article.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const totalHeight = rect.height - windowHeight;

      if (totalHeight <= 0) {
        bar.style.transform = 'scaleX(0)';
        ticking = false;
        return;
      }

      // Calculate progress percentage
      const scrolled = Math.max(0, -rect.top);
      const progress = Math.min(1, Math.max(0, scrolled / totalHeight));

      bar.style.transform = `scaleX(${progress})`;
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(updateProgress);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateProgress();
  }

  setupReadingProgress();
  document.addEventListener('astro:after-swap', setupReadingProgress);
</script>
