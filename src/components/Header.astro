---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/blog', label: 'Essays' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/uses', label: 'Uses' },
];

function isActive(href: string): boolean {
  if (href === '/blog') {
    return currentPath === '/blog' || currentPath.startsWith('/blog/') || currentPath.startsWith('/tags/') || currentPath.startsWith('/category/');
  }
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-40 w-full border-b border-[#e8e0d2] dark:border-[#2f2a24] bg-[#fbf8f3]/90 dark:bg-[#171513]/90 backdrop-blur-md transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-2">
    <!-- Brand -->
    <a href="/" class="group flex items-center gap-2 font-mono text-base font-semibold tracking-tight text-stone-900 dark:text-stone-100">
      <span class="w-2 h-2 rounded-full bg-amber-600 dark:bg-amber-400 inline-block group-hover:scale-125 transition-transform"></span>
      <span>faeem<span class="text-stone-400 dark:text-stone-500">.space</span></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden sm:flex items-center gap-1 sm:gap-1.5">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "px-3 py-1.5 text-sm rounded-md transition-colors",
            isActive(item.href)
              ? "text-[#231f1c] dark:text-[#f3ede4] font-medium bg-[#f0e8dc] dark:bg-[#26221d]"
              : "text-[#756c63] dark:text-[#968d81] hover:text-[#231f1c] dark:hover:text-[#f3ede4] hover:bg-[#f0e8dc]/50 dark:hover:bg-[#26221d]/40"
          ]}
        >
          {item.label}
        </a>
      ))}
      <div class="h-4 w-px bg-[#e8e0d2] dark:bg-[#2f2a24] mx-1"></div>
      <button
        type="button"
        class="search-trigger-btn flex items-center gap-2 px-2.5 py-1.5 text-xs font-mono text-[#756c63] dark:text-[#968d81] hover:text-[#231f1c] dark:hover:text-[#f3ede4] hover:bg-[#f0e8dc]/60 dark:hover:bg-[#26221d]/60 rounded-md border border-[#e8e0d2] dark:border-[#2f2a24] transition-colors cursor-pointer"
        aria-label="Search writings"
        title="Search writings (⌘K)"
      >
        <svg class="w-3.5 h-3.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="pointer-events-none">Search</span>
        <kbd class="pointer-events-none px-1.5 py-0.5 text-[10px] bg-[#f0e8dc] dark:bg-[#28241f] rounded text-[#554d45] dark:text-[#c4bcaf] font-mono">
          ⌘K
        </kbd>
      </button>
      <ThemeToggle />
    </nav>

    <!-- Mobile Nav Controls -->
    <div class="flex items-center gap-1 sm:hidden">
      <button
        type="button"
        class="search-trigger-btn p-2 text-[#756c63] dark:text-[#968d81] hover:text-[#231f1c] dark:hover:text-[#f3ede4] hover:bg-[#f0e8dc]/60 dark:hover:bg-[#26221d]/60 rounded-md transition-colors cursor-pointer"
        aria-label="Search writings"
        title="Search writings"
      >
        <svg class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <ThemeToggle />
      <button
        type="button"
        id="mobile-menu-btn"
        class="p-2 text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 rounded-md focus:outline-none"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-bars" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden sm:hidden border-t border-[#e8e0d2] dark:border-[#2f2a24] px-4 py-3 bg-[#fbf8f3] dark:bg-[#171513]">
    <div class="flex flex-col space-y-1">
      <a
        href="/"
        class:list={[
          "px-3 py-2 text-sm rounded-md transition-colors",
          currentPath === '/'
            ? "text-[#231f1c] dark:text-[#f3ede4] font-medium bg-[#f0e8dc] dark:bg-[#26221d]"
            : "text-[#756c63] dark:text-[#968d81] hover:text-[#231f1c] dark:hover:text-[#f3ede4]"
        ]}
      >
        Home
      </a>
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "px-3 py-2 text-sm rounded-md transition-colors",
            isActive(item.href)
              ? "text-[#231f1c] dark:text-[#f3ede4] font-medium bg-[#f0e8dc] dark:bg-[#26221d]"
              : "text-[#756c63] dark:text-[#968d81] hover:text-[#231f1c] dark:hover:text-[#f3ede4]"
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script is:inline>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconBars = document.getElementById('menu-icon-bars');
    const iconClose = document.getElementById('menu-icon-close');

    if (!btn || !menu || !iconBars || !iconClose) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconBars.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
