---
// CosmosGravity.astro
// Animated celestial cosmos system with each planet moving at its own pace.
interface Props {
  class?: string;
}

const { class: className = "w-28 h-28 sm:w-36 sm:h-36" } = Astro.props;

// Central star/core
const corePath = "M127.1,94.4c19.9,0,36.1,15.8,36.1,35.3s-16.2,35.3-36.1,35.3s-36.1-15.8-36.1-35.3S107.2,94.4,127.1,94.4z";

// Orbit 1 (~r=64) with its orbiting planet ball
const orbitInnerPath = "M127.1,65.7  c-36,0-65.2,28.7-65.2,63.9s29.2,63.9,65.2,63.9c15.7,0,30.2-5.5,41.5-14.7c1.9,1.3,4.2,1.9,6.8,1.9c7,0,12.6-5.5,12.6-12.2  c0-3.3-1.3-6.2-3.5-8.4c5.1-9.1,7.9-19.5,7.9-30.5C192.3,94.3,163.1,65.7,127.1,65.7z M181.2,157.6c-1.7-0.8-3.7-1.4-5.8-1.4  c-7,0-12.6,5.5-12.6,12.2c0,2.8,1.1,5.6,2.7,7.6c-10.4,8.3-23.8,13.3-38.4,13.3c-33.7,0-61.1-26.9-61.1-59.9s27.4-59.9,61.1-59.9  s61.1,26.9,61.1,59.9C188.3,139.6,185.7,149.2,181.2,157.6z";

// Orbit 2 (~r=80) with its orbiting planet ball
const orbitMiddlePath = "M127.7,49.5c-11.4,0-22.3,2.3-32.1,6.4c-1.6-2.4-4.4-4-7.6-4c-5.1,0-9.1,4-9.1,9  c0,1.4,0.3,2.7,0.9,3.9c-20.6,14.6-34,38.2-34,64.9c0,44.2,36.7,80.2,81.8,80.2s81.8-36,81.8-80.2S172.7,49.5,127.7,49.5z   M127.7,205.9c-42.8,0-77.7-34.2-77.7-76.2c0-25.4,12.8-47.9,32.3-61.8c1.6,1.3,3.5,1.9,5.7,1.9c5.1,0,9.1-4,9.1-9  c0-0.4,0-0.8-0.1-1.2c9.4-4,19.8-6.2,30.7-6.2c42.8,0,77.7,34.2,77.7,76.2S170.5,205.9,127.7,205.9z";

// Orbit 3 (~r=116) with its orbiting planet ball
const orbitOuterPath = "M251,67.5c0-11.7-9.7-21.2-21.6-21.2c-4.9,0-9.3,1.6-13,4.2  c-22.2-22.9-53.9-37.2-89-37.2c-67,0-121.5,52.1-121.5,116.2s54.5,116.2,121.5,116.2s121.5-52.1,121.5-116.2  c0-15.4-3.2-30.1-8.9-43.5C246.6,82.2,251,75.4,251,67.5z M244.8,129.4c0,61.9-52.6,112.3-117.4,112.3S9.9,191.2,9.9,129.4  S62.6,17.1,127.3,17.1c34,0,64.6,13.8,86.1,36c-3.5,3.8-5.7,8.8-5.7,14.3c0,11.7,9.7,21.2,21.6,21.2c2.4,0,4.7-0.4,7-1.2  C241.8,100.5,244.8,114.6,244.8,129.4z";
---

<div class:list={["shrink-0 flex items-center justify-center text-[#9e471d] dark:text-[#e57e4b]", className]}>
  <svg
    viewBox="0 0 256 256"
    class="w-full h-full fill-current select-none overflow-visible"
    xmlns="http://www.w3.org/2000/svg"
    aria-label="Celestial cosmos gravity orbits"
    role="img"
  >
    <!-- Central Core Star -->
    <g class="cosmos-core">
      <path d={corePath} />
    </g>

    <!-- Orbit 1: Inner Planet (Period: 14s) -->
    <g class="cosmos-orbit-inner">
      <path d={orbitInnerPath} />
    </g>

    <!-- Orbit 2: Middle Planet (Period: 24s) -->
    <g class="cosmos-orbit-middle">
      <path d={orbitMiddlePath} />
    </g>

    <!-- Orbit 3: Outer Planet (Period: 38s) -->
    <g class="cosmos-orbit-outer">
      <path d={orbitOuterPath} />
    </g>
  </svg>
</div>

<style>
  .cosmos-core,
  .cosmos-orbit-inner,
  .cosmos-orbit-middle,
  .cosmos-orbit-outer {
    transform-box: view-box;
    transform-origin: 127.4px 129.6px;
  }

  .cosmos-core {
    animation: cosmos-pulse 6s ease-in-out infinite alternate;
  }

  .cosmos-orbit-inner {
    animation: cosmos-spin 14s linear infinite;
  }

  .cosmos-orbit-middle {
    animation: cosmos-spin 24s linear infinite;
  }

  .cosmos-orbit-outer {
    animation: cosmos-spin 38s linear infinite;
  }

  @keyframes cosmos-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes cosmos-pulse {
    0% {
      transform: scale(0.96);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.03);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cosmos-orbit-inner,
    .cosmos-orbit-middle,
    .cosmos-orbit-outer,
    .cosmos-core {
      animation: none;
    }
  }
</style>
