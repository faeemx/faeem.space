---
interface Props {
  tag: string;
  count?: number;
  active?: boolean;
}

const { tag, count, active = false } = Astro.props;
---

<a
  href={`/tags/${encodeURIComponent(tag.toLowerCase())}`}
  class:list={[
    "inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono rounded-md border transition-colors",
    active
      ? "bg-[#ebd6be] text-[#231f1c] border-[#d8be9f] dark:bg-[#3d2e22] dark:text-[#f3ede4] dark:border-[#5a4432] font-medium"
      : "bg-[#f4efe5] text-[#5c5348] border-[#e8dfce] hover:text-[#231f1c] hover:border-[#cfc2ae] dark:bg-[#24211c] dark:text-[#a89f92] dark:border-[#332e28] dark:hover:text-[#f3ede4] dark:hover:border-[#494239]"
  ]}
>
  <span>#{tag}</span>
  {count !== undefined && (
    <span class="text-[11px] opacity-60">({count})</span>
  )}
</a>
