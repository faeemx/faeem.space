---
interface Props {
  tag: string;
  count?: number;
  active?: boolean;
}

const { tag, count, active = false } = Astro.props;
---

<a
  href={`/tags/${encodeURIComponent(tag.toLowerCase())}`}
  class:list={[
    "inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono rounded-md border transition-colors",
    active
      ? "bg-stone-300 text-stone-950 border-stone-400 dark:bg-stone-800 dark:text-stone-100 dark:border-stone-700 font-medium"
      : "bg-stone-100/80 text-stone-600 border-stone-200 hover:text-stone-950 hover:border-stone-300 dark:bg-stone-900/50 dark:text-stone-400 dark:border-stone-800 dark:hover:text-stone-200 dark:hover:border-stone-700"
  ]}
>
  <span>#{tag}</span>
  {count !== undefined && (
    <span class="text-[11px] opacity-60">({count})</span>
  )}
</a>
