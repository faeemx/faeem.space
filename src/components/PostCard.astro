---
import type { BlogPost } from '../utils/posts';
import { formatDate } from '../utils/posts';
import { getReadingTime } from '../utils/readingTime';
import TagBadge from './TagBadge.astro';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const readingTime = getReadingTime(post.body || '');
---

<article class="group relative flex flex-col items-start p-5 sm:p-6 rounded-xl border border-stone-200/80 dark:border-stone-800/80 bg-white/70 dark:bg-stone-900/20 hover:border-stone-300 dark:hover:border-stone-700 hover:shadow-xs transition-all">
  <!-- Metadata row -->
  <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-stone-500 dark:text-stone-400 mb-2.5">
    <time datetime={post.data.pubDate.toISOString()}>
      {formatDate(post.data.pubDate)}
    </time>
    <span>&middot;</span>
    <span>{readingTime}</span>
    {post.data.category && (
      <>
        <span>&middot;</span>
        <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-stone-100 text-stone-700 dark:bg-stone-800 dark:text-stone-300">
          {post.data.category}
        </span>
      </>
    )}
  </div>

  <!-- Title -->
  <h2 class="text-lg sm:text-xl font-semibold tracking-tight text-stone-900 dark:text-stone-100 group-hover:text-amber-800 dark:group-hover:text-amber-400 transition-colors">
    <a href={`/blog/${post.id}`}>
      <span class="absolute inset-0"></span>
      {post.data.title}
    </a>
  </h2>

  <!-- Description -->
  <p class="mt-2 text-sm text-stone-600 dark:text-stone-400 font-serif leading-relaxed line-clamp-2">
    {post.data.description}
  </p>

  <!-- Tags -->
  {post.data.tags && post.data.tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-1.5 relative z-10">
      {post.data.tags.map((tag) => (
        <TagBadge tag={tag} />
      ))}
    </div>
  )}
</article>
