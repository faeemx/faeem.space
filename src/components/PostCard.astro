---
import type { BlogPost } from '../utils/posts';
import { formatDate } from '../utils/posts';
import { getReadingTime } from '../utils/readingTime';
import TagBadge from './TagBadge.astro';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const readingTime = getReadingTime(post.body || '');
---

<article class="group relative flex flex-col items-start p-5 sm:p-6 rounded-xl border border-[#e8e0d2] dark:border-[#2f2a24] bg-white dark:bg-[#1f1c19] hover:border-[#cfc4b2] dark:hover:border-[#423c34] hover:shadow-xs transition-all">
  <!-- Metadata row -->
  <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-[#82786d] dark:text-[#91887c] mb-2.5">
    <time datetime={post.data.pubDate.toISOString()}>
      {formatDate(post.data.pubDate)}
    </time>
    <span>&middot;</span>
    <span>{readingTime}</span>
    {post.data.category && (
      <>
        <span>&middot;</span>
        <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-[#f2ece0] text-[#554d45] dark:bg-[#28241f] dark:text-[#c4bcaf]">
          {post.data.category}
        </span>
      </>
    )}
  </div>

  <!-- Title -->
  <h2 class="text-lg sm:text-xl font-semibold tracking-tight text-[#231f1c] dark:text-[#f3ede4] group-hover:text-[#9e471d] dark:group-hover:text-[#e57e4b] transition-colors">
    <a href={`/blog/${post.id}`}>
      <span class="absolute inset-0"></span>
      {post.data.title}
    </a>
  </h2>

  <!-- Description -->
  <p class="mt-2 text-sm sm:text-base text-[#5a5249] dark:text-[#b8b0a4] font-serif leading-relaxed line-clamp-2">
    {post.data.description}
  </p>

  <!-- Tags -->
  {post.data.tags && post.data.tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-1.5 relative z-10">
      {post.data.tags.map((tag) => (
        <TagBadge tag={tag} />
      ))}
    </div>
  )}
</article>
