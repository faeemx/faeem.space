---
const currentYear = new Date().getFullYear();

const links = [
  { label: 'GitHub', href: 'https://github.com' },
  { label: 'Twitter / X', href: 'https://x.com' },
  { label: 'RSS Feed', href: '/rss.xml' },
];
---

<footer class="mt-auto border-t border-zinc-200/80 dark:border-zinc-800/70 py-8 sm:py-12 transition-colors">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-500 dark:text-zinc-500">
    <div class="flex items-center gap-2">
      <span>&copy; {currentYear} Mando</span>
      <span>&middot;</span>
      <span>Built with Astro & TypeScript</span>
    </div>

    <div class="flex items-center gap-5">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('http') ? '_blank' : undefined}
          rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="hover:text-zinc-900 dark:hover:text-zinc-300 transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</footer>
