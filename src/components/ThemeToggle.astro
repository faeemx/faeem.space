---
// ThemeToggle.astro
---

<button
  type="button"
  class="theme-toggle-btn relative inline-flex items-center justify-center p-2 rounded-lg text-[#756c63] hover:text-[#231f1c] hover:bg-[#f0e8dc] dark:text-[#968d81] dark:hover:text-[#f3ede4] dark:hover:bg-[#26221d] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#9e471d] cursor-pointer"
  aria-label="Toggle light or dark theme"
  title="Toggle light or dark theme"
>
  <!-- Sun icon (shown in dark mode to switch to light) -->
  <svg
    class="theme-sun-icon w-4 h-4 text-[#d8cebe] pointer-events-none"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1m0 16v1m9-9h-1M4 9h1m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"
    />
  </svg>

  <!-- Moon icon (shown in light mode to switch to dark) -->
  <svg
    class="theme-moon-icon w-4 h-4 text-[#554d45] hover:text-[#231f1c] pointer-events-none"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    />
  </svg>
</button>

<style>
  /* Explicit display control matching current theme */
  :global(html.dark) .theme-sun-icon {
    display: block !important;
  }
  :global(html.dark) .theme-moon-icon {
    display: none !important;
  }
  :global(html:not(.dark)) .theme-sun-icon {
    display: none !important;
  }
  :global(html:not(.dark)) .theme-moon-icon {
    display: block !important;
  }
</style>

<script is:inline>
  // Global delegated theme switch handler attached only once
  if (!window.__themeToggleInitialized) {
    window.__themeToggleInitialized = true;

    document.addEventListener('click', (event) => {
      const btn = event.target && event.target.closest ? event.target.closest('.theme-toggle-btn') : null;
      if (!btn) return;

      event.preventDefault();
      event.stopPropagation();

      const html = document.documentElement;
      const willBeDark = !html.classList.contains('dark');

      if (willBeDark) {
        html.classList.add('dark');
        html.classList.remove('light');
      } else {
        html.classList.remove('dark');
        html.classList.add('light');
      }

      try {
        localStorage.setItem('theme', willBeDark ? 'dark' : 'light');
      } catch (err) {
        console.warn('Unable to access localStorage for theme:', err);
      }

      // Update theme-color meta tag for mobile browser address bar
      const metaThemeColor = document.querySelector('meta[name="theme-color"]');
      if (metaThemeColor) {
        metaThemeColor.setAttribute('content', willBeDark ? '#171513' : '#fbf8f3');
      }
    });
  }
</script>
