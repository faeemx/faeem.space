---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Filter to h2 and h3
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filtered.length > 1 && (
  <nav
    id="article-toc"
    class="my-8 p-5 rounded-xl border border-[#e8e0d2] dark:border-[#2f2a24] bg-[#f6f1e8] dark:bg-[#1f1c19] transition-colors"
    aria-label="Table of contents"
  >
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[#756c63] dark:text-[#968d81]">
        In this essay
      </span>
      <span class="text-[11px] font-mono text-[#8c8275] dark:text-[#91887c]">
        {filtered.length} sections
      </span>
    </div>

    <ul class="space-y-1.5 text-sm font-sans">
      {filtered.map((heading) => {
        const cleanText = heading.text.replace(/\s*#$/, '');
        return (
          <li class={heading.depth === 3 ? "ml-4" : ""}>
            <a
              href={`#${heading.slug}`}
              data-slug={heading.slug}
              class="toc-link block py-0.5 text-[#635b52] dark:text-[#a39a8e] hover:text-[#231f1c] dark:hover:text-[#f3ede4] transition-colors border-l-2 border-transparent pl-2.5 -ml-2.5"
            >
              {cleanText}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
)}

<script is:inline>
  function setupTocHighlight() {
    const tocLinks = document.querySelectorAll('.toc-link');
    if (!tocLinks.length) return;

    const headingElements = Array.from(tocLinks)
      .map((link) => {
        const slug = link.getAttribute('data-slug');
        return slug ? document.getElementById(slug) : null;
      })
      .filter(Boolean);

    if (!headingElements.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            tocLinks.forEach((link) => {
              if (link.getAttribute('data-slug') === id) {
                link.classList.add(
                  'text-[#231f1c]',
                  'dark:text-[#f3ede4]',
                  'font-medium',
                  'border-[#9e471d]',
                  'dark:border-[#e57e4b]'
                );
                link.classList.remove('border-transparent');
              } else {
                link.classList.remove(
                  'text-[#231f1c]',
                  'dark:text-[#f3ede4]',
                  'font-medium',
                  'border-[#9e471d]',
                  'dark:border-[#e57e4b]'
                );
                link.classList.add('border-transparent');
              }
            });
          }
        });
      },
      {
        rootMargin: '0px 0px -70% 0px',
        threshold: 0.1,
      }
    );

    headingElements.forEach((el) => {
      if (el) observer.observe(el);
    });
  }

  setupTocHighlight();
  document.addEventListener('astro:after-swap', setupTocHighlight);
</script>
