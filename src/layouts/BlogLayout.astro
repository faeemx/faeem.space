---
import BaseLayout from './BaseLayout.astro';
import TagBadge from '../components/TagBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import CodeBlockEnhancer from '../components/CodeBlockEnhancer.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { formatDate, type BlogPost } from '../utils/posts';
import { getReadingTime } from '../utils/readingTime';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: BlogPost;
  headings?: Heading[];
  prevPost?: BlogPost;
  nextPost?: BlogPost;
  relatedPosts?: BlogPost[];
}

const { post, headings = [], prevPost, nextPost, relatedPosts = [] } = Astro.props;
const readingTime = getReadingTime(post.body || '');
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  articleDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  image={post.data.coverImage}
  type="article"
>
  <!-- Reading Progress Bar -->
  <ReadingProgress />

  <article class="max-w-[680px] mx-auto">
    <!-- Back button -->
    <div class="mb-8">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-[#756c63] dark:text-[#968d81] hover:text-[#231f1c] dark:hover:text-[#f3ede4] transition-colors"
      >
        <span>&larr;</span>
        <span>Back to all essays</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="mb-10 pb-8 border-b border-[#e8e0d2] dark:border-[#2f2a24]">
      <!-- Metadata Row -->
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-[#82786d] dark:text-[#91887c] mb-4">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <span>&middot;</span>
        <span>{readingTime}</span>
        {post.data.category && (
          <>
            <span>&middot;</span>
            <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-[#f2ece0] text-[#554d45] dark:bg-[#28241f] dark:text-[#c4bcaf]">
              {post.data.category}
            </span>
          </>
        )}
      </div>

      <!-- Main Title (Literary Serif) -->
      <h1 class="font-serif text-3xl sm:text-4xl md:text-[2.65rem] font-bold tracking-tight text-[#231f1c] dark:text-[#f3ede4] mb-4 leading-[1.2]">
        {post.data.title}
      </h1>

      <!-- Description / Subtitle -->
      <p class="text-lg sm:text-xl text-[#635b52] dark:text-[#aba194] font-serif italic leading-relaxed">
        {post.data.description}
      </p>

      <!-- Tags row & updated date -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => (
              <TagBadge tag={tag} />
            ))}
          </div>
        )}

        {post.data.updatedDate && (
          <div class="text-[11px] font-mono text-[#82786d] dark:text-[#91887c]">
            Updated: {formatDate(post.data.updatedDate)}
          </div>
        )}
      </div>

      <!-- Optional Cover Image -->
      {post.data.coverImage && (
        <div class="mt-8 overflow-hidden rounded-xl border border-[#e8e0d2] dark:border-[#2f2a24]">
          <img
            src={post.data.coverImage}
            alt={post.data.title}
            class="w-full h-auto object-cover max-h-[400px]"
            loading="lazy"
          />
        </div>
      )}
    </header>

    <!-- Table of Contents (if essay has multiple headings) -->
    {headings && headings.length > 0 && (
      <TableOfContents headings={headings} />
    )}

    <!-- Article Content with Reader-friendly Typography -->
    <div class="article-prose">
      <slot />
    </div>

    <!-- Related Articles -->
    {relatedPosts.length > 0 && (
      <RelatedPosts posts={relatedPosts} />
    )}

    <!-- Article Footer / Navigation -->
    <footer class="mt-16 pt-8 border-t border-[#e8e0d2] dark:border-[#2f2a24]">
      <!-- Prev / Next Navigation -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prevPost ? (
          <a
            href={`/blog/${prevPost.id}`}
            class="group p-4 rounded-xl border border-[#e8e0d2] dark:border-[#2f2a24] bg-white dark:bg-[#1f1c19] hover:border-[#cfc4b2] dark:hover:border-[#423c34] transition-all flex flex-col"
          >
            <span class="text-xs font-mono text-[#82786d] dark:text-[#91887c] mb-1 flex items-center gap-1">
              &larr; Previous essay
            </span>
            <span class="text-sm font-medium text-[#231f1c] dark:text-[#f3ede4] group-hover:text-[#9e471d] dark:group-hover:text-[#e57e4b] transition-colors line-clamp-1">
              {prevPost.data.title}
            </span>
          </a>
        ) : (
          <div class="hidden sm:block" />
        )}

        {nextPost ? (
          <a
            href={`/blog/${nextPost.id}`}
            class="group p-4 rounded-xl border border-[#e8e0d2] dark:border-[#2f2a24] bg-white dark:bg-[#1f1c19] hover:border-[#cfc4b2] dark:hover:border-[#423c34] transition-all flex flex-col items-start sm:items-end text-left sm:text-right"
          >
            <span class="text-xs font-mono text-[#82786d] dark:text-[#91887c] mb-1 flex items-center gap-1">
              Next essay &rarr;
            </span>
            <span class="text-sm font-medium text-[#231f1c] dark:text-[#f3ede4] group-hover:text-[#9e471d] dark:group-hover:text-[#e57e4b] transition-colors line-clamp-1">
              {nextPost.data.title}
            </span>
          </a>
        ) : (
          <div class="hidden sm:block" />
        )}
      </div>

      <div class="mt-8 text-center">
        <a
          href="/blog"
          class="text-xs font-mono text-[#756c63] dark:text-[#968d81] hover:text-[#231f1c] dark:hover:text-[#f3ede4] transition-colors"
        >
          &uarr; Back to all essays
        </a>
      </div>
    </footer>
  </article>

  <!-- Client-side Code Block copy buttons & language tags -->
  <CodeBlockEnhancer />
</BaseLayout>
